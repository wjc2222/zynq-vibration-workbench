From: AX7Z020 project <local-build@invalid>
Subject: [PATCH] usb: phy: add fixed Zynq ULPI viewport and VBUS glue

Upstream 6.6.70 supplies ULPI operations but no OF platform binding for the
ulpi-phy node used by this AX7Z020/USB3320 carrier. Register a built-in USB2
PHY and connect ChipIdea's PHY VBUS callback to the existing ULPI OTG helper.

Adapted from Xilinx linux-xlnx tag xlnx_rebase_v6.6_LTS_merge_6.6.70,
drivers/usb/phy/phy-ulpi.c (GPL-2.0+), upstream source SHA256
9b2e3374b0682a2ce65adaac8cc6bb0f14799fe8c6b4dbc90abc3e3dfc919935.
Use devm allocation, validate viewport bounds, handle ioremap NULL correctly,
and disable runtime unbinding for the fixed board platform. Propagate ULPI
read errors before set_host/set_vbus write a register; an errno is not data. This board patch
is not a claim that the whole kernel is the Xilinx branch.

--- a/drivers/usb/phy/phy-ulpi.c
+++ b/drivers/usb/phy/phy-ulpi.c
@@ -13,6 +13,10 @@
 #include <linux/kernel.h>
 #include <linux/slab.h>
 #include <linux/export.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
 #include <linux/usb.h>
 #include <linux/usb/otg.h>
 #include <linux/usb/ulpi.h>
@@ -199,7 +203,12 @@
 static int ulpi_set_host(struct usb_otg *otg, struct usb_bus *host)
 {
 	struct usb_phy *phy = otg->usb_phy;
-	unsigned int flags = usb_phy_io_read(phy, ULPI_IFC_CTRL);
+	unsigned int flags;
+	int ret = usb_phy_io_read(phy, ULPI_IFC_CTRL);
+
+	if (ret < 0)
+		return ret;
+	flags = ret;
 
 	if (!host) {
 		otg->host = NULL;
@@ -225,7 +234,12 @@
 static int ulpi_set_vbus(struct usb_otg *otg, bool on)
 {
 	struct usb_phy *phy = otg->usb_phy;
-	unsigned int flags = usb_phy_io_read(phy, ULPI_OTG_CTRL);
+	unsigned int flags;
+	int ret = usb_phy_io_read(phy, ULPI_OTG_CTRL);
+
+	if (ret < 0)
+		return ret;
+	flags = ret;
 
 	flags &= ~(ULPI_OTG_CTRL_DRVVBUS | ULPI_OTG_CTRL_DRVVBUS_EXT);
 
@@ -301,3 +315,68 @@
 	return phy;
 }
 EXPORT_SYMBOL_GPL(devm_otg_ulpi_create);
+
+/* AX7Z020 uses USB3320 CPEN to gate the carrier's VBUS switch.
+ * Adapted from the Xilinx 6.6.70 ULPI viewport platform glue; the upstream
+ * ULPI core remains responsible for transceiver discovery and OTG control.
+ * The viewport shares the ChipIdea controller range: map, do not reserve it.
+ */
+static int ax7z020_ulpi_set_vbus(struct usb_phy *phy, int on)
+{
+	return ulpi_set_vbus(phy->otg, !!on);
+}
+
+static int ax7z020_ulpi_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct resource *res;
+	struct usb_phy *phy;
+	void __iomem *base;
+	u32 offset;
+	unsigned int flags = 0;
+	int ret;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res)
+		return -EINVAL;
+	ret = of_property_read_u32(dev->of_node, "view-port", &offset);
+	if (ret)
+		return ret;
+	if (resource_size(res) < sizeof(u32) || (offset & 3) ||
+	    offset > resource_size(res) - sizeof(u32))
+		return -EINVAL;
+	base = devm_ioremap(dev, res->start, resource_size(res));
+	if (!base)
+		return -ENOMEM;
+	if (of_property_read_bool(dev->of_node, "drv-vbus"))
+		flags |= ULPI_OTG_DRVVBUS;
+	if (of_property_read_bool(dev->of_node, "external-drv-vbus"))
+		flags |= ULPI_OTG_DRVVBUS_EXT;
+	phy = devm_otg_ulpi_create(dev, &ulpi_viewport_access_ops, flags);
+	if (!phy)
+		return -ENOMEM;
+	phy->dev = dev;
+	phy->type = USB_PHY_TYPE_USB2;
+	phy->io_priv = base + offset;
+	phy->set_vbus = ax7z020_ulpi_set_vbus;
+	ret = usb_add_phy_dev(phy);
+	if (ret)
+		return ret;
+	dev_info(dev, "AX7Z020 ULPI viewport PHY registered; VBUS controlled by ChipIdea\n");
+	return 0;
+}
+
+static const struct of_device_id ax7z020_ulpi_match[] = {
+	{ .compatible = "ulpi-phy" },
+	{ }
+};
+
+static struct platform_driver ax7z020_ulpi_driver = {
+	.probe = ax7z020_ulpi_probe,
+	.driver = {
+		.name = "ax7z020-ulpi-phy",
+		.of_match_table = ax7z020_ulpi_match,
+		.suppress_bind_attrs = true,
+	},
+};
+builtin_platform_driver(ax7z020_ulpi_driver);
--- a/drivers/usb/phy/Kconfig
+++ b/drivers/usb/phy/Kconfig
@@ -161,6 +161,7 @@
 config USB_ULPI
 	bool "Generic ULPI Transceiver Driver"
 	depends on ARM || ARM64 || COMPILE_TEST
+	select USB_PHY
 	select USB_ULPI_VIEWPORT
 	help
 	  Enable this to support ULPI connected USB OTG transceivers which
