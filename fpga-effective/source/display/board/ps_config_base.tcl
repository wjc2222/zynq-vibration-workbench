    CONFIG.PCW_EN_CLK3_PORT {0} \
    CONFIG.PCW_EN_RST0_PORT {0} \
    CONFIG.PCW_EN_RST1_PORT {0} \
    CONFIG.PCW_EN_RST2_PORT {0} \
    CONFIG.PCW_EN_RST3_PORT {0}]

# RGMII at 1.8 V uses the Zynq HSTL option, matching the PHY's 1.8-V domain.
for {set mio 16} {$mio <= 27} {incr mio} {
    lappend ax7z020_ps_config CONFIG.PCW_MIO_${mio}_IOTYPE {HSTL 1.8V}
}
