config BR2_PACKAGE_VIBRATION_OFFLINE
	bool "vibration offline analyzer"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_8
	help
	  Build the project's C++17 CAPDDR2 parser, FFT and evidence CLI.
	  This package does not operate acquisition hardware.

if BR2_PACKAGE_VIBRATION_OFFLINE
config BR2_PACKAGE_VIBRATION_OFFLINE_GUI
	bool "Qt Widgets interface"
	depends on BR2_PACKAGE_QT5BASE_WIDGETS
	help
	  Build the software-rendered GUI. A working display driver and
	  framebuffer must still be supplied by the board's PL design.
endif
