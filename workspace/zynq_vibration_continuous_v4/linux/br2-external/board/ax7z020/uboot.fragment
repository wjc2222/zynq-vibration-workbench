CONFIG_DEFAULT_DEVICE_TREE="zynq-ax7z020"
CONFIG_SYS_CONFIG_NAME="zynq-ax7z020"
CONFIG_ENV_SOURCE_FILE="ax7z020"
# CONFIG_USE_DEFAULT_ENV_FILE is not set
CONFIG_OF_LIST="zynq-ax7z020"
# CONFIG_OF_BOARD is not set
CONFIG_OF_SEPARATE=y
# CONFIG_SPL is not set
CONFIG_BOOTDELAY=-1
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="echo AX7Z020 ready - run ramboot after JTAG RAM load"
# CONFIG_USE_PREBOOT is not set
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_FAT is not set
# CONFIG_ENV_IS_IN_EXT4 is not set
# CONFIG_ENV_IS_IN_NAND is not set
# CONFIG_ENV_IS_IN_SPI_FLASH is not set
# CONFIG_SYS_REDUNDAND_ENVIRONMENT is not set
# CONFIG_ENV_VARS_UBOOT_RUNTIME_CONFIG is not set
# CONFIG_CMD_SAVEENV is not set
# CONFIG_CMD_ENV_SAVE is not set
# CONFIG_CMD_EXT4_WRITE is not set
# CONFIG_CMD_FAT_WRITE is not set
# CONFIG_MTD is not set
# CONFIG_CMD_MTD is not set
# CONFIG_CMD_UBI is not set
# CONFIG_CMD_UBIFS is not set
# CONFIG_MTD_UBI is not set
# CONFIG_UBIFS_SUPPORT is not set
# CONFIG_CMD_NAND is not set
# CONFIG_CMD_SF is not set
# CONFIG_CMD_SF_TEST is not set
# CONFIG_MTD_RAW_NAND is not set
# CONFIG_SPI_FLASH is not set
# CONFIG_ZYNQ_QSPI is not set
# CONFIG_USB_GADGET is not set
# CONFIG_DFU is not set
# CONFIG_CMD_DFU is not set
# CONFIG_CMD_THOR_DOWNLOAD is not set
# CONFIG_EFI_LOADER is not set
# CONFIG_EFI_RUNTIME_UPDATE_CAPSULE is not set
# CONFIG_TOOLS_MKEFICAPSULE is not set
CONFIG_SYS_BOOTM_LEN=0x10000000
CONFIG_SYS_LOAD_ADDR=0x02000000
CONFIG_PHY_MICREL=y
CONFIG_PHY_MICREL_KSZ90X1=y
CONFIG_CMD_BOOTZ=y
CONFIG_CMD_MMC=y
CONFIG_CMD_FAT=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_CMD_USB=y
CONFIG_CMD_GPIO=y
CONFIG_CMD_ECHO=y
CONFIG_CMD_SETEXPR=y
CONFIG_CMD_ITEST=y
CONFIG_GPIO_HOG=y
