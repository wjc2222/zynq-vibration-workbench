/* Environment is RAM-only. Never run saveenv or write an existing card. */
stdin=serial
stdout=serial
stderr=serial
baudrate=115200
kernel_addr_r=0x02000000
fdt_addr_r=0x01f00000
ramdisk_addr_r=0x10000000
fdt_high=0xffffffff
initrd_high=0xffffffff
bootargs=console=ttyPS0,115200 earlycon rdinit=/sbin/init
ramboot=if test -n "${ramdisk_size}"; then bootz ${kernel_addr_r} ${ramdisk_addr_r}:${ramdisk_size} ${fdt_addr_r}; else echo Set ramdisk_size to the exact rootfs.cpio.gz byte count before booting; fi
sdboot=echo SD deployment is intentionally not automatic; use the documented staged files after authorization
